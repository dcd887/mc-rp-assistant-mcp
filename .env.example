# mc-rp-assistant-mcp 可配置项（复制为 .env 后按需修改，重启生效）
# 优先级：环境变量 > .env 文件 > rp-config.json > 内置默认值

# Modrinth API 根地址，支持自建网关/代理
# RP_ASSISTANT_MODRINTH_API_BASE=https://api.modrinth.com/v2

# 请求 User-Agent（Modrinth 要求标明来源）
# RP_ASSISTANT_USER_AGENT=mc-rp-assistant-mcp/1.0

# 单张纹理大小上限（MB），超过则标记为大纹理
# RP_ASSISTANT_TEXTURE_MAX_MB=2

# 资源包图标 pack.png 大小上限（KB）
# RP_ASSISTANT_PACK_ICON_MAX_KB=50

# Modrinth 资源包搜索的默认返回条数 / 上限
# RP_ASSISTANT_DEFAULT_SEARCH_LIMIT=10
# RP_ASSISTANT_MAX_SEARCH_RESULTS=50
