{
  "name": "mc-rp-assistant-mcp",
  "version": "1.0.0",
  "description": "MCP server for Minecraft resource pack analysis, validation, and management",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "mc-rp-assistant-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/rp-config.json','dist/rp-config.json')\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node test.js",
    "test:unit": "node --test --test-force-exit __tests__/unit.test.ts",
    "test:all": "npm run test:unit && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
